# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://DB_USERNAME:DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# API keys
API_FOOTBALL_KEY=your_api_football_key
RAPIDAPI_HOST=your_rapidapi_host
RAPIDAPI_KEY=your_rapidapi_key

# FastAPI secret
SECRET_KEY=your_secret_key_here

# Base URL for your backend
BASE_URL=https://yourapp.example.com

# Cron secret
CRON_SECRET=your_cron_secret_here

# Google Sign-In (Web Client ID from Firebase/Google Cloud Console — used to
# verify the audience of Google ID tokens sent from the mobile app)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Apple Sign-In (the app's iOS bundle identifier — used to verify the
# audience of Apple ID tokens sent from the mobile app)
APPLE_BUNDLE_ID=com.yourcompany.yourapp
# Outgoing email (forgot-password codes). Any SMTP provider works - e.g. a
# Gmail account with an App Password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<16-char app password>.
# EMAIL_FROM defaults to SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
